# Copy to .env and fill the account-specific values before `mage e2e:aws`.
# .env is ignored; never commit real AWS access keys or session tokens.

# AWS SDK / CAPA credential chain. Leave blank to use an AWS profile, SSO, or
# another ambient credential source instead of static credentials.
AWS_PROFILE=
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Required by the CAPA workload-cluster template. mage e2e:aws builds and pushes
# ZFS_CSI_IMAGE_REPO:ZFS_CSI_IMAGE_TAG, then sets E2E_DRIVER_IMAGE to that tag.
AWS_SSH_KEY_NAME=
E2E_SSH_PRIVATE_KEY_PATH=
AWS_AMI_ID=
ZFS_CSI_IMAGE_REPO=
ZFS_CSI_IMAGE_TAG=dev

# Optional provider-fixture override for the E2E NFS export CIDR. Leave empty
# to use the selected provider's fixture network; this is not a product default.
E2E_NFS_EXPORT_CIDRS=

# CAPA identityRef. These defaults use the controller identity installed by
# CAPA. Set AWSClusterStaticIdentity and its resource name for another account.
AWS_IDENTITY_KIND=AWSClusterControllerIdentity
AWS_IDENTITY_NAME=default

# A stable ID preserves a development cluster across `mage e2e:aws` runs.
E2E_RUN_ID=aws-dev

# Optional: set to 1 to add the long external-storage conformance suite.
E2E_RUN_CONFORMANCE=0

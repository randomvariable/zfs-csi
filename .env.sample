# SAMPLE static E2E lane environment — copy to .env.static (gitignored) and
# fill in real values. Never commit the real file.
# Usage: set -a; . ./.env.static; set +a; mage e2e:static

E2E_RUN_ID=static-dev
E2E_INFRASTRUCTURE_CONFIG=/path/to/gitignored/infrastructure-static.yaml
E2E_WORKLOAD_KUBECONFIG=/path/to/cluster.kubeconfig

# Driver image reachable from every participating node (digest preferred).
E2E_DRIVER_IMAGE=<registry>/<repo>@sha256:<digest>

# StorageClass renames: avoid colliding with classes other drivers own.
E2E_STORAGE_CLASS_OVERRIDES=tankNVMe=zfs-e2e-nvme,tankNFS=zfs-e2e-nfs,tankNFSTLS=zfs-e2e-nfs-tls,tankNVMeTLS=zfs-e2e-nvme-tls

# Consumer-node subnets for the NFS StorageClasses.
E2E_NFS_EXPORT_CIDRS=192.0.2.0/24

# Site taints the conformance preflight ignores. On the static lane these are
# also added as NoSchedule tolerations on the storage-owner Deployments.
E2E_NON_BLOCKING_TAINTS=zfs.csi.randomvariable.co.uk/storage,node-role.kubernetes.io/nas,node-role.kubernetes.io/control-plane

# Tolerated NotReady node count for conformance (shared clusters).
E2E_ALLOWED_NOT_READY_NODES=1

E2E_ZPOOL=tank
E2E_ENCRYPTION=0
E2E_SKIP_CLEANUP=1
E2E_TRANSPORT_TLS=0
E2E_RUN_CONFORMANCE=0
